//
// File throughput test (Photoshop UXPScript). Run via File > Scripts, or
// through a Scripts panel double-click - Photoshop executes .psjs files in
// the UXPScript engine, not classic ExtendScript.
//
// This is a thin standalone runner - the actual benchmark lives in
// ../shared/throughputTest.js (symlinked in here as ./throughputTest.js) so
// it can also run unchanged from inside a real UXP plugin panel; see
// ../throughput-panel/. See that shared file for what's actually measured
// and why.
//
// `crdtuxp.js` here is a symlink to ../../CreativeDeveloperTools_UXP/crdtuxp.js
// - kept as a local symlink (rather than a `../../` require path) because a
// packaged UXP plugin cannot require() outside its own folder, and every
// sample in this repo uses the same `./crdtuxp.js` require regardless of
// whether it happens to be a loose script or a plugin.
//

if (! global.crdtuxp) {
    global.crdtuxp = global.require("./crdtuxp.js");
    crdtuxp.init();
}

const throughputTest = global.require("./throughputTest.js");

async function main() {
    const result = await throughputTest.run(crdtuxp);
    const reportText = throughputTest.formatReport(result);

    // Visible in the UXP Developer Tools console when run in dev/debug mode.
    console.log(reportText);

    // Also written to disk (direct local access, always available to a
    // standalone UXPScript) so the results are visible even when nothing is
    // watching the console - e.g. this script run standalone via
    // File > Scripts / double-click.
    if (result.scratchDir) {
        try {
            const reportPath = result.scratchDir + crdtuxp.path.SEPARATOR + "crdtuxp_throughput_test_report.txt";
            const reportHandle = await crdtuxp.fileOpen(reportPath, "w");
            if (reportHandle !== undefined) {
                await crdtuxp.fileWrite(reportHandle, reportText);
                await crdtuxp.fileClose(reportHandle);
                crdtuxp.logNote(arguments, "Report written to " + reportPath);
            }
        }
        catch (err) {
            crdtuxp.logError(arguments, "could not write report file: " + err);
        }
    }

    return reportText;
}

module.exports.main = main;

return main();
