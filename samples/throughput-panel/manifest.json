{
  "id": "crdtuxp-throughput-test-panel-sample",
  "name": "crdtuxp-throughput-test-panel-sample",
  "version": "0.0.1",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "23.0"
    }
  ],
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": [
        "localhost.tgrg.net"
      ]
    },
    "clipboard": "readAndWrite"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "showPanel",
      "minimumSize": {
        "width": 600,
        "height": 500
      },
      "maximumSize": {
        "width": 2400,
        "height": 1800
      },
      "preferredDockedSize": {
        "width": 900,
        "height": 800
      },
      "preferredFloatingSize": {
        "width": 900,
        "height": 800
      },
      "label": {
        "default": "CRDT_UXP Throughput Test"
      },
      "icons": [
        {
          "width": 23,
          "height": 23,
          "path": "icons/dark.png",
          "scale": [1, 2],
          "theme": ["darkest", "dark", "medium"]
        },
        {
          "width": 23,
          "height": 23,
          "path": "icons/light.png",
          "scale": [1, 2],
          "theme": ["lightest", "light"]
        }
      ]
    }
  ],
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/plugin.png",
      "scale": [1, 2],
      "theme": ["darkest", "dark", "medium", "lightest", "light", "all"],
      "species": ["pluginList"]
    }
  ]
}
